        # Upload handled directly by UploadEngine v2.7
        pass


        state.add(
            "FILES UPLOADED"
        )



        # Commit

        commit = commit_engine.create(
            "XDeploy automated commit"
        )


        state.add(
            "COMMIT CREATED"
        )



        # Repository

        repo = repository.setup(

            config.get(
                "repo_mode",
                "EXISTING"
            ),

            config.get(
                "repo",
                "UNKNOWN"
            )

        )


        state.add(
            "REPOSITORY READY"
        )



        # Push

        push_result = push.run(config.get(
                "repo"),

            {

                "auth":
                    config.get(
                        "auth"
                    )

            }

        )


        state.add(
            "PUSH FINISHED"
        )


        result = {

            "pipeline":
                "XDEPLOY",

            "status":
                push_result["status"],

            "steps":
                state.get()

        }


        bus.emit(
            "Deploy finished",
            "SUCCESS"
        )


        

        try:

            import json

            with open(

                'xdeploy_trace.json',

                'w'

            ) as f:

                json.dump(

                    result,

                    f,

                    indent=4,

                    default=str

                )

        except Exception as e:

            print(

                'TRACE ERROR',

                e

            )


        return result






